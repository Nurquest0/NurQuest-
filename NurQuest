  });


/* =========================
   QUIZ
========================= */

function startQuiz(selectedMode){

  mode=selectedMode;

  quizQuestions=[...masterDeck]
    .sort(()=>Math.random()-.5)
    .slice(0,10);

  current=0;
  score=0;
  answered=false;
  wrongQuestions=[];

  clearInterval(timer);

  document.getElementById("relaxedMode")
    .classList.toggle("selected",mode==="relaxed");

  document.getElementById("challengeMode")
    .classList.toggle("selected",mode==="challenge");

  loadQuestion();
}


function loadQuestion(){

  clearInterval(timer);

  if(current>=quizQuestions.length){
    finishQuiz();
    return;
  }

  answered=false;

  const q=quizQuestions[current];

  document.getElementById("questionNumber")
    .textContent=
      `Soalan ${current+1} / ${quizQuestions.length}`;

  document.getElementById("progressBar")
    .style.width=
      `${(current/quizQuestions.length)*100}%`;

  document.getElementById("questionText")
    .textContent=q.q;

  const options=document.getElementById("options");

  options.innerHTML="";

  q.a.forEach((answer,index)=>{

    const button=document.createElement("button");

    button.className="option";

    button.textContent=
      `${String.fromCharCode(65+index)}. ${answer}`;

    button.onclick=()=>chooseAnswer(index,button);

    options.appendChild(button);

  });

  document.getElementById("feedback")
    .innerHTML="";

  document.getElementById("nextButton")
    .disabled=true;

  document.getElementById("hintButton")
    .style.display=
      mode==="relaxed" ? "block" : "none";

  document.getElementById("timer")
    .textContent="";

  if(mode==="challenge"){
    startTimer();
  }
}


function chooseAnswer(index,button){

  if(answered) return;

  answered=true;

  clearInterval(timer);

  const q=quizQuestions[current];

  const allOptions=
    document.querySelectorAll(".option");

  allOptions.forEach(b=>b.disabled=true);

  if(index===q.correct){

    score++;

    button.classList.add("correct");

    document.getElementById("feedback").innerHTML=
      `<div class="feedback good">
      ✓ Betul! ${q.explain}
      </div>`;

    updateTopic(q.topic,true);

    playTone(true);

  }else{

    button.classList.add("wrong");

    allOptions[q.correct]
      .classList.add("correct");

    wrongQuestions.push(q);

    document.getElementById("feedback").innerHTML=
      `<div class="feedback bad">
      ✗ Kurang tepat.<br>${q.explain}
      </div>`;

    updateTopic(q.topic,false);

    playTone(false);
  }

  document.getElementById("nextButton")
    .disabled=false;
}


function nextQuestion(){

  current++;

  loadQuestion();
}


function showHint(){

  if(answered) return;

  const q=quizQuestions[current];

  document.getElementById("feedback").innerHTML=
    `<div class="hint">💡 ${q.hint}</div>`;
}


function startTimer(){

  let seconds=20;

  document.getElementById("timer")
    .textContent=`⏱ ${seconds}s`;

  timer=setInterval(()=>{

    seconds--;

    document.getElementById("timer")
      .textContent=`⏱ ${seconds}s`;

    if(seconds<=0){

      clearInterval(timer);

      if(!answered){

        answered=true;

        const q=quizQuestions[current];

        wrongQuestions.push(q);

        document.querySelectorAll(".option")
          .forEach(b=>b.disabled=true);

        document.querySelectorAll(".option")
          [q.correct]
          ?.classList.add("correct");

        document.getElementById("feedback")
          .innerHTML=
          `<div class="feedback bad">
          ⏱ Masa tamat.<br>${q.explain}
          </div>`;

        updateTopic(q.topic,false);

        document.getElementById("nextButton")
          .disabled=false;

      }

    }

  },1000);
}


function finishQuiz(){

  clearInterval(timer);

  const percentage=
    Math.round((score/quizQuestions.length)*100);

  history.unshift({
    score,
    total:quizQuestions.length,
    percentage,
    date:new Date().toLocaleDateString("ms-MY"),
    mode
  });

  history=history.slice(0,10);

  localStorage.setItem(
    "nurquestHistory",
    JSON.stringify(history)
  );

  if(percentage===100){
    localStorage.setItem(
      "nurquestHero",
      "true"
    );
  }

  updateStreak();

  document.getElementById("quizBox").innerHTML=`

    <div class="result">

      <div class="eyebrow">Keputusan</div>

      <div class="score">
        ${percentage}%
      </div>

      <h2>
        ${score} / ${quizQuestions.length}
      </h2>

      <p>
        ${
          percentage===100
          ? "Tahniah! Anda mendapat markah penuh."
          : percentage>=70
          ? "Tahniah! Kefahaman anda adalah baik."
          : "Teruskan ulang kaji dan cuba lagi."
        }
      </p>

      ${
        wrongQuestions.length
        ? `
        <div class="review">
          <h3>Soalan yang perlu diulang kaji</h3>
          <p>
            ${wrongQuestions.length} soalan perlu diberi perhatian.
          </p>
          <button class="btn secondary"
            onclick="reviewWrong()">
            🔁 Ulang Kaji
          </button>
        </div>
        `
        : ""
      }

      <br>

      <button class="btn"
        onclick="startQuiz('${mode}')">
        Cuba Lagi
      </button>

    </div>
  `;

  updatePerformance();
}


/* =========================
   WRONG QUESTIONS
========================= */

function reviewWrong(){

  const saved=JSON.parse(
    localStorage.getItem("nurquestWrong") || "[]"
  );

  const combined=[
    ...wrongQuestions,
    ...saved
  ];

  const unique=[
    ...new Map(
      combined.map(q=>[q.q,q])
    ).values()
  ];

  if(!unique.length){

    alert("Belum ada soalan salah untuk diulang kaji.");

    return;
  }

  quizQuestions=unique
    .sort(()=>Math.random()-.5);

  current=0;
  score=0;
  answered=false;
  mode="relaxed";

  goTo("quiz");

  loadQuestion();
}


/* =========================
   TOPIC ANALYTICS
========================= */

function updateTopic(topic,correct){

  if(!topicStats[topic]){
    topicStats[topic]={
      correct:0,
      wrong:0
    };
  }

  if(correct)
    topicStats[topic].correct++;
  else
    topicStats[topic].wrong++;

  localStorage.setItem(
    "nurquestTopicStats",
    JSON.stringify(topicStats)
  );

  const savedWrong=JSON.parse(
    localStorage.getItem("nurquestWrong") || "[]"
  );

  if(!correct){

    savedWrong.push(
      quizQuestions[current]
    );

    localStorage.setItem(
      "nurquestWrong",
      JSON.stringify(savedWrong.slice(-30))
    );

  }
}


function updatePerformance(){

  document.getElementById("streakText")
    .textContent=`${streak} hari`;

  document.getElementById("notesRead")
    .textContent=
      notesRead.includes("all")
      ? "6 / 6"
      : "0 / 6";

  if(history.length){

    const best=Math.max(
      ...history.map(x=>x.percentage)
    );

    document.getElementById("bestScore")
      .textContent=`${best}%`;

  }else{

    document.getElementById("bestScore")
      .textContent="Belum ada";

  }


  const container=
    document.getElementById("topicStats");

  container.innerHTML="";

  const topics=Object.keys(topicStats);

  if(!topics.length){

    container.innerHTML=
      `<p class="lead">
      Jawab beberapa soalan untuk melihat analisis topik.
      </p>`;

  }else{

    topics.forEach(topic=>{

      const data=topicStats[topic];

      const total=data.correct+data.wrong;

      const percent=
        total
        ? Math.round((data.correct/total)*100)
        : 0;

      container.innerHTML+=`

        <div style="margin:15px 0">

          <b>${topic}</b>

          <div class="bar">
            <span style="width:${percent}%"></span>
          </div>

          <small>
            ${percent}% betul
            (${data.correct} betul / ${data.wrong} salah)
          </small>

        </div>

      `;

    });

  }


  const historyBox=
    document.getElementById("history");

  if(!history.length){

    historyBox.innerHTML=
      `<p class="lead">Belum ada rekod kuiz.</p>`;

  }else{

    historyBox.innerHTML=
      history.map(item=>`

        <div class="history-item">

          <span>
            ${item.date}
            • ${item.mode==="challenge"
              ? "Zon Cabaran"
              : "Zon Santai"}
          </span>

          <b>
            ${item.percentage}%
          </b>

        </div>

      `).join("");

  }

}


