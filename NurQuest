function changeFont(amount){

  const currentSize=
    parseFloat(
      getComputedStyle(document.documentElement)
      .fontSize
    );

  const newSize=
    Math.min(
      22,
      Math.max(
        13,
        currentSize+amount
      )
    );

  document.documentElement.style.fontSize=
    newSize+"px";

  localStorage.setItem(
    "nurquestFont",
    newSize
  );

}


function resetData(){

  const confirmReset=
    confirm(
      "Padam semua sejarah, markah dan kemajuan?"
    );

  if(!confirmReset) return;

  localStorage.removeItem("nurquestTopicStats");
  localStorage.removeItem("nurquestHistory");
  localStorage.removeItem("nurquestStreak");
  localStorage.removeItem("nurquestNotesRead");
  localStorage.removeItem("nurquestWrong");
  localStorage.removeItem("nurquestHero");
  localStorage.removeItem("nurquestLastDate");

  alert("Data telah direset.");

  location.reload();

}


/* =========================
   AUDIO
========================= */

function playTone(correct){

  try{

    const AudioContext=
      window.AudioContext ||
      window.webkitAudioContext;

    if(!AudioContext) return;

    const ctx=new AudioContext();

    const oscillator=
      ctx.createOscillator();

    const gain=
      ctx.createGain();

    oscillator.connect(gain);

    gain.connect(ctx.destination);

    oscillator.frequency.value=
      correct ? 700 : 250;

    gain.gain.value=.04;

    oscillator.start();

    oscillator.stop(
      ctx.currentTime+.12
    );

  }catch(e){}

}


