   NOTES
========================= */

function filterNotes(){

  const text=
    document.getElementById("noteSearch")
    .value.toLowerCase();

  document.querySelectorAll(".note").forEach(note=>{

    const content=note.innerText.toLowerCase();

    note.style.display=
      content.includes(text) ? "" : "none";

  });

}


function setLanguage(lang){

  document.querySelectorAll(".rumi")
    .forEach(x=>x.style.display=lang==="rumi"?"":"none");

  document.querySelectorAll(".jawi")
    .forEach(x=>x.style.display=lang==="jawi"?"":"none");

  document.getElementById("rumiBtn")
    .classList.toggle("selected",lang==="rumi");

  document.getElementById("jawiBtn")
    .classList.toggle("selected",lang==="jawi");
}


